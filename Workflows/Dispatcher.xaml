string swStatus = match != null ? match["Status_Switch"].ToString().Trim() : "NOT_FOUND";

targetRow = dtTransactionData.NewRow();
targetRow["TransactionId"] = trxId;
targetRow["AccountNumber"] = CurrentRow["No_Rekening"].ToString().Trim();
targetRow["Channel"] = CurrentRow["Channel"].ToString().Trim();
targetRow["CoreAmount"] = CurrentRow["Nominal_Core"].ToString().Trim();
targetRow["CoreStatus"] = CurrentRow["Status_Core"].ToString().Trim();
targetRow["SwitchingAmount"] = swAmount;
targetRow["SwitchingStatus"] = swStatus;
targetRow["TransactionTimestamp"] = CurrentRow["Waktu_Transaksi"].ToString().Trim();
dtTransactionData.Rows.Add(targetRow);</x:String>
